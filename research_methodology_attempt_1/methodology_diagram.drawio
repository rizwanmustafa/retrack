<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="arl-attempt-1" name="ARL methodology">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c11" value="&lt;b&gt;Research methodology — attempt 1: ARL (Augment · Remember · Link) on top of the retrained TrackTacular baseline&lt;/b&gt;&lt;br&gt;Goal: raise MODA (r = 0.5 m) and MOTA / IDF1 (r = 1 m) on WILDTRACK (7 cameras, frames 0–359 train, 360–399 test)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1760" height="50" as="geometry"/></mxCell>
        <mxCell id="c12" value="Stage A — detector training  (targets MODA, feeds tracking)" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontSize=13;fontStyle=1;startSize=34;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="75" width="1760" height="395" as="geometry"/></mxCell>
        <mxCell id="c13" value="Stage B — detection decoding  (MODA)" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=13;fontStyle=1;startSize=34;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="480" width="1760" height="150" as="geometry"/></mxCell>
        <mxCell id="c14" value="Stage C — association  (MOTA, IDF1)" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=13;fontStyle=1;startSize=34;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="1760" height="230" as="geometry"/></mxCell>
        <mxCell id="c15" value="Stage D — experimental protocol" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#666666;fontSize=13;fontStyle=1;startSize=34;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="880" width="1760" height="200" as="geometry"/></mxCell>
        <mxCell id="c16" value="&lt;b&gt;7 synchronised views&lt;/b&gt;&lt;br&gt;1080×1920 → 720×1280&lt;br&gt;+ calibration K, [R|t]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="95" width="150" height="70" as="geometry"/></mxCell>
        <mxCell id="c17" value="&lt;b&gt;A1 · 3D random occlusion&lt;/b&gt;&lt;br&gt;n = 25 person-sized cylinders on the ground, projected into &lt;i&gt;all&lt;/i&gt; views (p ∈ {0.5, 1.0})" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#36393d;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="250" y="95" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="c18" value="&lt;b&gt;View augmentation&lt;/b&gt;&lt;br&gt;resize ∈ [0.8, 1.2] + crop, K adjusted&lt;br&gt;(existing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="470" y="95" width="170" height="70" as="geometry"/></mxCell>
        <mxCell id="c19" value="&lt;b&gt;ResNet-18 encoder&lt;/b&gt;&lt;br&gt;ImageNet-1K init&lt;br&gt;(kept: EarlyBird Tab. 4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="670" y="95" width="150" height="70" as="geometry"/></mxCell>
        <mxCell id="c20" value="&lt;b&gt;Bilinear-sampling lift&lt;/b&gt;&lt;br&gt;voxels 120 × 4 × 360&lt;br&gt;(10 cm × 10 cm × 50 cm)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="850" y="95" width="180" height="70" as="geometry"/></mxCell>
        <mxCell id="c21" value="&lt;b&gt;Concat fusion&lt;/b&gt;&lt;br&gt;+ BEV compressor&lt;br&gt;(no camera dropout)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1060" y="95" width="160" height="70" as="geometry"/></mxCell>
        <mxCell id="c22" value="&lt;b&gt;A3 · temporal history ON&lt;/b&gt;&lt;br&gt;concat cached BEV(t−1)&lt;br&gt;use_temporal_cache: True" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#36393d;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1250" y="95" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="c23" value="&lt;b&gt;Decoder heads&lt;/b&gt;&lt;br&gt;centre (focal) · offset (L1)&lt;br&gt;prev-offset (smooth-L1) · image centre" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1470" y="95" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="c24" value="&lt;b&gt;A2 · scene augmentation&lt;/b&gt;&lt;br&gt;random BEV flip / small affine of ref_T_global, applied to GT(t) &lt;i&gt;and&lt;/i&gt; GT(t−1), p = 0.5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#36393d;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="850" y="190" width="180" height="70" as="geometry"/></mxCell>
        <mxCell id="c25" value="&lt;b&gt;A4 · optional&lt;/b&gt;&lt;br&gt;VGF + ray conditioning&lt;br&gt;/ large-kernel refiner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="1060" y="190" width="160" height="70" as="geometry"/></mxCell>
        <mxCell id="c26" value="&lt;b&gt;A5 · optional&lt;/b&gt;&lt;br&gt;average weights of last k epochs (SWA)&lt;br&gt;evaluate last/averaged, never best-on-test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="1470" y="190" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c34" value="same transform" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="c24" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c35" value="replaces / adds" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;dashed=1;" edge="1" parent="1" source="c25" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;dashed=1;" edge="1" parent="1" source="c23" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c37" value="&lt;b&gt;Evidence for A1&lt;/b&gt;&lt;br&gt;3DROM [P05] Tab. 3 (WILDTRACK): MVDet 88.2 → 92.3 MODA with 3D random occlusion only; Tab. 6: 3D occlusion 93.5 vs per-view random erasing 92.0; Tab. 5: MODA rises with p, best at p = 100 %.&lt;br&gt;Width ratio α is not given in [P05]: we start from 0.4 (repo reid.py) and sweep." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="290" width="270" height="165" as="geometry"/></mxCell>
        <mxCell id="c38" value="&lt;b&gt;Evidence for A2&lt;/b&gt;&lt;br&gt;MVAug [P06] Tab. 2–4 (WILDTRACK, single runs): no aug 90.86 → view+scene affine 93.17 MODA; 50 % augmentation best, 100 % worse (90.44).&lt;br&gt;Code audit: current scene aug = identity rotation + ±0.25 grid-cell shift (≈ 6 mm), and GT(t−1) is not transformed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="350" y="290" width="270" height="165" as="geometry"/></mxCell>
        <mxCell id="c39" value="&lt;b&gt;Evidence for A3&lt;/b&gt;&lt;br&gt;TrackTacular [P08] Tab. 4 (MultiviewX): history fusion MODA 95.4 → 96.5, IDF1 81.5 → 83.8 (MODP and MOTA drop; motion head then lifts MOTA to 92.4).&lt;br&gt;Code audit: upstream d_wildtrack.yml ships use_temporal_cache: False, so the WILDTRACK baseline never sees t−1." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="630" y="290" width="270" height="165" as="geometry"/></mxCell>
        <mxCell id="c40" value="&lt;b&gt;Evidence for A4 (optional)&lt;/b&gt;&lt;br&gt;GRACE [P22] Tab. 1: retrained TrackTacular, 7 cams 88.50 → 92.58 MODA with VGF + Ray.&lt;br&gt;MVFP [P21] ablation (WILDTRACK): large-kernel refiner 92.3 → 93.2, + foreground selector 94.1.&lt;br&gt;ATLASFusion [P17] Tab. 4: +1.5 MODA, +0.6 IDF1." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="910" y="290" width="270" height="165" as="geometry"/></mxCell>
        <mxCell id="c41" value="&lt;b&gt;Kept as-is, with evidence&lt;/b&gt;&lt;br&gt;ResNet-18: EarlyBird [P07] Tab. 4 on WILDTRACK R18 91.2 &gt; R50 89.6 &gt; Swin-T 89.5 MODA.&lt;br&gt;No camera dropout: Simple-BEV [P27] Tab. IIIc 6/6 cams beats 5/6.&lt;br&gt;Bilinear sampling, not deformable attention: [P08] Tab. 1 78.4 MODA (over-fits)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1190" y="290" width="270" height="165" as="geometry"/></mxCell>
        <mxCell id="c42" value="&lt;b&gt;Constraint found in the code&lt;/b&gt;&lt;br&gt;The temporal cache is keyed by frame id only. With per-sample scene augmentation the cached BEV(t−1) would be in a different frame of reference → the scene transform must be shared by consecutive frames in a TemporalSampler chunk (or A2 is off when A3 is on: ablate both)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1470" y="290" width="290" height="165" as="geometry"/></mxCell>
        <mxCell id="c43" value="&lt;b&gt;3×3 max-pool NMS&lt;/b&gt;&lt;br&gt;top-K = 60 peaks&lt;br&gt;+ sub-cell offset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="520" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="c44" value="&lt;b&gt;B1 · threshold τ calibration&lt;/b&gt;&lt;br&gt;sweep τ ∈ [0.30, 0.70]&lt;br&gt;clean: chosen on val model · oracle: on test (labelled)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c3e6cb;strokeColor=#36393d;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="300" y="520" width="230" height="70" as="geometry"/></mxCell>
        <mxCell id="c45" value="&lt;b&gt;Per-frame detections&lt;/b&gt;&lt;br&gt;{ xy, xy_prev, score }&lt;br&gt;cached to disk once per model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="560" y="520" width="230" height="70" as="geometry"/></mxCell>
        <mxCell id="c46" value="&lt;b&gt;MODA / MODP / P / R&lt;/b&gt;&lt;br&gt;Hungarian, r = 0.5 m&lt;br&gt;evaluation/mod.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="820" y="520" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="c47" value="&lt;b&gt;Note.&lt;/b&gt; MODA is computed on per-frame detections, so Stage C cannot change it under the standard protocol. Detections are cached so that every Stage C ablation runs without new inference. The Retrack Stage 1 sweep already implements B1; attempt 1 adds the clean (validation-model) variant." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1050" y="515" width="700" height="80" as="geometry"/></mxCell>
        <mxCell id="c48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="c23" target="c43"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="c43" target="c44"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="c44" target="c45"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="c45" target="c46"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c52" value="&lt;b&gt;C1 · online BEV tracker&lt;/b&gt;&lt;br&gt;Kalman + learned prev-offset cost&lt;br&gt;ByteTrack 2-pass: high τ starts, τ_low only continues (BTR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffd8a8;strokeColor=#36393d;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="685" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="c53" value="&lt;b&gt;short, high-precision tracklets&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="350" y="685" width="150" height="80" as="geometry"/></mxCell>
        <mxCell id="c54" value="&lt;b&gt;C2 · offline global linking&lt;/b&gt;&lt;br&gt;min-cost path cover over tracklets (exact, Hungarian with 'no-link')&lt;br&gt;cost = motion-extrapolation gap + Δt penalty (+ OSNet appearance)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffd8a8;strokeColor=#36393d;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="530" y="685" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="c55" value="&lt;b&gt;C3 · Gaussian-smoothed interpolation&lt;/b&gt;&lt;br&gt;fill gaps ≤ G frames&lt;br&gt;inside linked tracks only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffd8a8;strokeColor=#36393d;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="860" y="685" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="c56" value="&lt;b&gt;MOTA / IDF1 / MOTP&lt;/b&gt;&lt;br&gt;py-motmetrics, r = 1 m&lt;br&gt;evaluation/mot_bev.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1110" y="685" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="c57" value="&lt;b&gt;C2b · ablation&lt;/b&gt;: detection-level min-cost flow (KSP / muSSP-style) with the prev-offset term in the edge cost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="530" y="780" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="c58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="c45" target="c52"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="c52" target="c53"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="c53" target="c54"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="c54" target="c55"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="c55" target="c56"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;dashed=1;" edge="1" parent="1" source="c45" target="c57"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c64" value="&lt;b&gt;Evidence for Stage C&lt;/b&gt;&lt;br&gt;MVFlow [P09] Tab. 2: &lt;i&gt;same&lt;/i&gt; MVDeTr detections — DeepSORT 24.0 MOTA / 56.3 IDF1 → muSSP 89.4 / 90.7.&lt;br&gt;MCBLT† [P19] Tab. 3: &lt;i&gt;same&lt;/i&gt; EarlyBird detections 89.5 / 92.3 → offline GNN 92.6 / 95.6.&lt;br&gt;StrongSORT [P12] Tab. II (MOT17): AFLink + GSI on CenterTrack (a motion-offset tracker like TrackTacular) +3.8 IDF1; AFLink + GSI change MOTA by +0.1 (CenterTrack) to +2.0 (FairMOT) across 6 trackers.&lt;br&gt;ByteTrack [P10] Tab. 3: BYTE on CenterTrack +1.3 MOTA, +9.8 IDF1.&lt;br&gt;GRACE [P22]: BTR at 7 cams 90.73 → 91.04 MOTA." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1340" y="650" width="420" height="210" as="geometry"/></mxCell>
        <mxCell id="c65" value="&lt;b&gt;Baselines&lt;/b&gt;&lt;br&gt;B0 = retrained TrackTacular (this repo)&lt;br&gt;reference: paper 92.1 / 91.8 / 95.3 [P08]&lt;br&gt;reproduced: 88.50 / 89.71 / 94.00 [P22]&lt;br&gt;(MODA / MOTA / IDF1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="920" width="260" height="130" as="geometry"/></mxCell>
        <mxCell id="c66" value="&lt;b&gt;Two tuning protocols&lt;/b&gt;&lt;br&gt;&lt;b&gt;clean&lt;/b&gt;: train on frames 0–323, tune τ and tracker on 324–359, retrain on 0–359 with the chosen values&lt;br&gt;&lt;b&gt;oracle&lt;/b&gt; (allowed over-fit): tune on 360–399, always labelled as oracle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="360" y="920" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="c67" value="&lt;b&gt;Ablation ladder&lt;/b&gt;&lt;br&gt;B0 → +A1 → +A2 → +A3 → +A1A2A3&lt;br&gt;→ +B1 → +C1 → +C2 → +C3 (full ARL)&lt;br&gt;optional: +A4, +A5, C2b&lt;br&gt;stage C runs on cached detections" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="690" y="920" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="c68" value="&lt;b&gt;Statistics&lt;/b&gt;&lt;br&gt;3 seeds per trained configuration (seed spread on WILDTRACK is about ±1 MODA, ±1.2 IDF1 [P38])&lt;br&gt;report mean ± std, Welch t-test vs B0&lt;br&gt;and raw FN / FP / IDSW / Frag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1020" y="920" width="330" height="130" as="geometry"/></mxCell>
        <mxCell id="c69" value="&lt;b&gt;Decision rule (fixed before running)&lt;/b&gt;&lt;br&gt;keep a component only if it improves its target metric by more than one baseline std over 3 seeds without lowering the other two primary metrics by more than one std" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1380" y="920" width="370" height="130" as="geometry"/></mxCell>
        <mxCell id="c70" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="c65" target="c66"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c71" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="c66" target="c67"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c72" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="c67" target="c68"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c73" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="c68" target="c69"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
