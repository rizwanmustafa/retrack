# Copy to .env (or export these variables) before starting the server.
RETRACK_ENV=development
RETRACK_SECRET_KEY=change-me-to-a-long-random-value
RETRACK_MONGO_URI=mongodb://localhost:27017
RETRACK_MONGO_DB=retrack
RETRACK_CHECKPOINT_DIR=./instance/checkpoints
RETRACK_RECORDED_SOURCES_FILE=./instance/recorded_sources.json
RETRACK_INFERENCE_DEVICE=auto
RETRACK_AUTH_IDLE_TIMEOUT_MINUTES=30
# Set to true behind HTTPS outside local development (NFR-04)
RETRACK_REQUIRE_HTTPS=false
